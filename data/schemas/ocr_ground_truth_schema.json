{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ocr_ground_truth_schema.json",
  "title": "OCR Ground Truth Schema",
  "description": "Schema for OCR ground truth data in HueCIT Chatbot RAG pipeline",
  "version": "1.0.0",
  "type": "object",
  "required": ["screen_id", "ground_truth_text"],
  "properties": {
    "screen_id": {
      "type": "string",
      "description": "Reference to screenshot"
    },
    "ground_truth_text": {
      "type": "string",
      "description": "Manually transcribed text from screenshot"
    },
    "annotator": {
      "type": "string",
      "description": "Person who created the ground truth"
    },
    "language": {
      "type": "string",
      "enum": ["vi", "en"],
      "default": "vi"
    },
    "text_regions": {
      "type": "array",
      "description": "Individual text regions with bounding boxes",
      "items": {
        "type": "object",
        "properties": {
          "region_id": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 4,
            "maxItems": 4,
            "description": "[x, y, width, height]"
          },
          "text": {
            "type": "string"
          },
          "region_type": {
            "type": "string",
            "enum": ["text", "code", "error_message", "button", "label", "other"]
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
